# docker-unomp environment overrides for docker-compose.yml
# Copy to .env and adjust as needed. All values are optional.

# Image tag to run (default: latest)
UNOMP_IMAGE_TAG=latest

# Host port mappings. UNOMP's actual listening ports are defined in
# config.json; keep these in sync with your configuration.
UNOMP_HTTP_PORT=80
UNOMP_API_PORT=3008
UNOMP_STRATUM_PORT_1=3032
UNOMP_STRATUM_PORT_2=3256

# Host port for the bundled Redis server
REDIS_PORT=6379
